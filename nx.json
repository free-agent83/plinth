{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.{ts,tsx,mjs}",
      "!{projectRoot}/**/*.test-d.ts",
      "!{projectRoot}/**/*.stories.tsx",
      "!{projectRoot}/tests/**/*"
    ],
    "componentsTestReadsOutsideProject": [
      "{workspaceRoot}/.agents/skills/**/*",
      "{workspaceRoot}/.claude/settings.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/packages/undrift/src/gate.mjs",
      "{workspaceRoot}/packages/tokens/tests/**/*",
      "{workspaceRoot}/*.md",
      "{workspaceRoot}/undrift.config.json",
      "{workspaceRoot}/apps/web/app/**/*",
      "{workspaceRoot}/apps/web/lib/**/*",
      "{workspaceRoot}/apps/web/content/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "test:types": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    }
  }
}
