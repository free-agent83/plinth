{
  "name": "plinth",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:tokens": "npm -w @plinth/tokens run build",
    "prepare": "npm run build:tokens",
    "test:tokens": "npm -w @plinth/tokens run test",
    "test:components": "npm -w @plinth/components run test",
    "test:types": "npm -w @plinth/components run test:types",
    "test:storybook": "npm -w @plinth/components run test:storybook",
    "test:undrift": "npm -w undrift run test",
    "test": "nx run-many -t test,test:types",
    "gate": "node packages/undrift/bin/undrift.mjs gate",
    "audit": "node packages/undrift/bin/undrift.mjs audit",
    "pregate": "npm run build:tokens",
    "blast-radius": "node scripts/blast-radius.mjs",
    "predev": "npm run build:tokens",
    "dev": "npm -w web run dev",
    "build:web": "npm -w web run build"
  },
  "devDependencies": {
    "culori": "^4.0.0",
    "nx": "^22.7.8",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  }
}
